{
  "description": "claude-for-network: APPROVE-gated device changes, approval capture, `setup claude for network here`, site rules",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-python\" --fail-closed \"${CLAUDE_PLUGIN_ROOT}/hooks/change_guard.py\""}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/approval_capture.py\""},
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/setup_trigger.py\""}
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/site_rules.py\""}
        ]
      }
    ]
  }
}
