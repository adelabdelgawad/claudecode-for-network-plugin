# Network credentials — DO NOT COMMIT OR SHARE
# Devices reference a credential set via devices.credential_ref in inventory/inventory.db
# Pattern: NET_<REF>_USERNAME / NET_<REF>_PASSWORD / NET_<REF>_ENABLE

# Default credential set (credential_ref = 'DEFAULT')
NET_DEFAULT_USERNAME=
NET_DEFAULT_PASSWORD=
NET_DEFAULT_ENABLE=

# Sophos XG / SFOS firewalls — SSH console (devices.credential_ref = 'SOPHOS', os_type sophos_sfos)
NET_SOPHOS_USERNAME=
NET_SOPHOS_PASSWORD=
NET_SOPHOS_ENABLE=

# Sophos XG XML API, Get-only (firewall_details.api_credential_ref = 'SOPHOSAPI')
# Use a dedicated read-only admin profile; on each XG: Backup & firmware > API >
# enable API configuration and add this host's IP to the allowed list.
NET_SOPHOSAPI_USERNAME=
NET_SOPHOSAPI_PASSWORD=

# Inventory location
INVENTORY_DB=inventory/inventory.db

# ---------------------------------------------------------------------------
# VMware vSphere (vCenter / ESXi) — hosts live in inventory (vcenters / esxi_hosts),
# only credentials go here. Use a read-only vCenter role for discovery/audits.
# ---------------------------------------------------------------------------
# vCenter SSO account (credential_ref = 'VCENTER'), e.g. svc-claude-ro@vsphere.local
NET_VCENTER_USERNAME=
NET_VCENTER_PASSWORD=

# ESXi direct/host-level login (credential_ref = 'ESXI'), only if vCenter is unavailable
NET_ESXI_USERNAME=
NET_ESXI_PASSWORD=

# ---------------------------------------------------------------------------
# Guest operating systems (machines.credential_ref)
# ---------------------------------------------------------------------------
# Windows servers over WinRM (credential_ref = 'WINDOWS'), e.g. DOMAIN\svc-claude
NET_WINDOWS_USERNAME=
NET_WINDOWS_PASSWORD=
# WinRM transport: ntlm | kerberos | credssp ; port 5985 (http) / 5986 (https)
WINRM_TRANSPORT=ntlm

# Linux servers over SSH (credential_ref = 'LINUX'); key auth preferred over password
NET_LINUX_USERNAME=
NET_LINUX_PASSWORD=
NET_LINUX_SSH_KEY=
# sudo password if different from the login password
NET_LINUX_ENABLE=

# ---------------------------------------------------------------------------
# Veeam Backup & Replication (credential_ref = 'VEEAM') — REST API (port 9419),
# e.g. DOMAIN\svc-claude-ro with the Veeam Backup Viewer role (read-only).
# Hosts go in the inventory, only credentials here.
# ---------------------------------------------------------------------------
NET_VEEAM_USERNAME=
NET_VEEAM_PASSWORD=
